<!DOCTYPE html>
<html lang="pt-PT">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Associação Desportiva Fabio Santos</title>
<link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@600;700;800&display=swap" rel="stylesheet">
<style>
:root{
  --verde:#970000; --verde-escuro:#fdf8f8; --amarelo:#080701;
  --texto:#16211D; --cinza:#EEF2F0; --linha:#D5DDD9;
  --titulo:'Barlow Condensed','Arial Narrow',sans-serif;
  --corpo:'Barlow',system-ui,sans-serif;
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:4.5rem}
body{margin:0;font-family:var(--corpo);color:var(--texto);line-height:1.6;font-size:1.05rem}
h1,h2,h3{font-family:var(--titulo);line-height:1.1;margin:0 0 .5em}
h1{font-size:clamp(3rem,9vw,6rem);font-weight:800}
h2{font-size:clamp(2rem,5vw,3rem);font-weight:700}
h3{font-size:1.5rem;font-weight:700}
a{color:inherit}
:focus-visible{outline:3px solid var(--amarelo);outline-offset:3px}
.contentor{width:min(1100px,100% - 2rem);margin-inline:auto}
.contentor--estreito{width:min(460px,100% - 2rem)}

/* Botões */
.botao{display:inline-block;padding:.8rem 1.5rem;background:var(--amarelo);color:var(--texto);font-weight:600;text-decoration:none;border:2px solid var(--amarelo);border-radius:4px;cursor:pointer;font-family:inherit;font-size:1rem}
.botao:hover{background:#fff;border-color:#fff}
.botao--contorno{background:transparent;color:#fff;border-color:#fff}
.botao--contorno:hover{background:#fff;color:var(--verde-escuro)}
.botao--pequeno{padding:.4rem 1rem}
.ligacao{font-weight:600;color:var(--verde)}

/* Cabeçalho */
.topo{background:var(--verde-escuro);color:#fff;position:sticky;top:0;z-index:5}
.topo__barra{display:flex;align-items:center;justify-content:space-between;padding-block:.8rem;flex-wrap:wrap;gap:.5rem}
.marca{font-family:var(--titulo);font-size:1.5rem;font-weight:800;text-decoration:none}
.menu{display:flex;align-items:center;gap:1.4rem}
.menu a{text-decoration:none;font-weight:500}
.menu a:not(.botao):hover{color:var(--amarelo)}
.menu-botao{display:none;background:none;border:2px solid #fff;color:#fff;padding:.3rem .9rem;font:inherit;border-radius:4px}

/* Hero */
.hero{background:var(--verde);color:#fff;padding-block:clamp(4rem,12vw,8rem);position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;inset:1.5rem;border:3px solid rgba(255,255,255,.25);pointer-events:none}
.hero::after{content:"";position:absolute;top:1.5rem;bottom:1.5rem;left:66%;border-left:3px solid rgba(255,255,255,.25);pointer-events:none}
.hero__conteudo{position:relative;z-index:1}
.hero__texto{max-width:36rem;font-size:1.25rem;margin-bottom:2rem}
.hero__acoes{display:flex;gap:1rem;flex-wrap:wrap}

/* Secções */
.secao{padding-block:4rem}
.secao--cinza{background:var(--cinza)}
.grelha{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:1.5rem}
.bloco{border-top:4px solid var(--verde);padding-top:1rem}
.preco{font-weight:600;font-size:1.2rem;margin:0 0 .5rem}

/* Eventos */
.eventos{list-style:none;padding:0;margin:0}
.evento{display:flex;gap:1.2rem;align-items:center;padding-block:1rem;border-bottom:1px solid var(--linha)}
.evento h3,.evento p{margin:0}
.evento__data{display:flex;flex-direction:column;align-items:center;min-width:4.5rem;background:var(--verde);color:#fff;padding:.5rem;border-radius:4px}
.evento__dia{font-family:var(--titulo);font-size:2rem;font-weight:800;line-height:1}
.evento__mes{font-size:.85rem}

/* Chamada */
.chamada{background:var(--verde-escuro);color:#fff;padding-block:4rem}
.chamada p{max-width:36rem}

/* Formulário */
.formulario{display:grid;gap:.4rem}
.formulario label{font-weight:600;margin-top:.6rem}
.formulario input,.formulario textarea{padding:.7rem;font:inherit;border:2px solid var(--linha);border-radius:4px}
.formulario input:focus,.formulario textarea:focus{border-color:var(--verde)}
.formulario .botao{margin-top:1rem;background:var(--verde);color:#fff;border-color:var(--verde)}
.formulario .botao:hover{background:var(--verde-escuro);border-color:var(--verde-escuro)}

/* Rodapé */
.rodape{background:var(--texto);color:#dfe6e2;padding-top:3rem}
.rodape__grelha{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:2rem}
.rodape p{margin:.3rem 0 0}
.rodape__fim{text-align:center;padding:1.5rem 1rem;font-size:.9rem;opacity:.8}

/* Telemóvel */
@media(max-width:760px){
  .menu-botao{display:block}
  .menu{display:none;width:100%;flex-direction:column;align-items:flex-start;padding-bottom:1rem}
  .menu--aberto{display:flex}
  .hero::after{display:none}
}
</style>
</head>
<body>

<header class="topo">
  <div class="contentor topo__barra">
    <a class="marca" href="#inicio">Associação Desportiva Fabio Santos</a>
    <button class="menu-botao" aria-expanded="false" aria-controls="menu">Menu</button>
    <nav id="menu" class="menu" aria-label="Principal">
      <a href="#modalidades">jiujitsu</a>
      <a href="#eventos">Eventos</a>
      <a href="#loja">Loja</a>
      <a href="#contactos">Contactos</a>
      <a class="botao botao--pequeno" href="#socio">Área de sócio</a>
    </nav>
  </div>
</header>

<main id="inicio">

<section class="hero">
  <div class="contentor hero__conteudo">
    <h1>Treina. Compete. Pertence.</h1>
    <p class="hero__texto">Modalidades, horários, eventos e loja oficial da Associação Desportiva Fabio Santos, num só sítio.</p>
    <div class="hero__acoes">
      <a class="botao" href="#contactos">Quero experimentar</a>
      <a class="botao botao--contorno" href="#modalidades">Ver modalidades</a>
    </div>
  </div>
</section>

<section class="secao" id="modalidades">
  <div class="contentor">
    <h2>Modalidades</h2>
    <div class="grelha">
      <article class="bloco"><h3>jiujistu 1</h3><p>Descrição curta da modalidade. Adultos, horários e treinadores.</p></article>
      <article class="bloco"><h3>jiujistu 2</h3><p>Descrição curta da modalidade. Crianças, horários e treinadores.</p></article>
    </div>
  </div>
</section>

<section class="secao secao--cinza" id="eventos">
  <div class="contentor">
    <h2>Próximos eventos</h2>
    <ul class="eventos">
      <li class="evento">
        <time class="evento__data" datetime="2026-11-07T16:00"><span class="evento__dia">07</span><span class="evento__mes">11/2026</span></time>
        <div><h3>Jogo em casa</h3><p>16:00 · Pavilhão Municipal</p></div>
      </li>
      <li class="evento">
        <time class="evento__data" datetime="2026-11-14T10:30"><span class="evento__dia">14</span><span class="evento__mes">11/2026</span></time>
        <div><h3>Treino aberto</h3><p>10:30 · Pavilhão Municipal</p></div>
      </li>
      <li class="evento">
        <time class="evento__data" datetime="2026-12-13T09:00"><span class="evento__dia">13</span><span class="evento__mes">12/2026</span></time>
        <div><h3>Torneio de Natal</h3><p>09:00 · Pavilhão Municipal</p></div>
      </li>
    </ul>
  </div>
</section>

<section class="secao" id="loja">
  <div class="contentor">
    <h2>Loja oficial</h2>
    <div class="grelha">
      <article class="bloco"><h3>Camisola oficial</h3><p class="preco">25,00 €</p><a class="ligacao" href="#loja">Ver produto</a></article>
      <article class="bloco"><h3>Fato de treino</h3><p class="preco">40,00 €</p><a class="ligacao" href="#loja">Ver produto</a></article>
      <article class="bloco"><h3>Cachecol do clube</h3><p class="preco">10,00 €</p><a class="ligacao" href="#loja">Ver produto</a></article>
    </div>
  </div>
</section>

<section class="chamada" id="socio">
  <div class="contentor">
    <h2>Já és sócio?</h2>
    <p>Consulta as tuas quotas, convocatórias e planos de treino na área reservada.</p>
    <a class="botao" href="#socio">Entrar na área de sócio</a>
  </div>
</section>

<section class="secao" id="contactos">
  <div class="contentor contentor--estreito">
    <h2>Contactos</h2>
    <form class="formulario" onsubmit="event.preventDefault(); alert('Mensagem de exemplo. O envio real será feito mais tarde com PHP.');">
      <label for="nome">Nome</label>
      <input id="nome" name="nome" required>
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required>
      <label for="mensagem">Mensagem</label>
      <textarea id="mensagem" name="mensagem" rows="4" required></textarea>
      <button class="botao" type="submit">Enviar</button>
    </form>
  </div>
</section>

</main>

<footer class="rodape">
  <div class="contentor rodape__grelha">
    <div><strong>Associação Desportiva Fabio Santos</strong><p>Largo da Estação, n.º 4<br>2350-323 , Riachos</p></div>
    <div><strong>Contacto</strong><p>geral@associacao.pt<br>000 000 000</p></div>
    <div><strong>Ligações</strong><p><a href="#contactos">Quero ser sócio</a><br><a href="#loja">Loja oficial</a></p></div>
  </div>
  <p class="rodape__fim">© 2026 Associação Desportiva Fabio Santos. Projeto de PAP.</p>
</footer>

<script>
  // Abre e fecha o menu no telemóvel
  const botao = document.querySelector('.menu-botao');
  const menu = document.getElementById('menu');
  botao.addEventListener('click', () => {
    const aberto = menu.classList.toggle('menu--aberto');
    botao.setAttribute('aria-expanded', aberto);
  });
</script>

</body>
</html>
